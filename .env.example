# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables)

# Canonical production URL (used for sitemap, OG, canonical, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://asaddevlabs.vercel.app

# Where enquiries are sent
NEXT_PUBLIC_CONTACT_EMAIL=asadlawliet@gmail.com

# Google Analytics 4 measurement ID (optional) — e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
